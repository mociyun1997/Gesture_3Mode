        <mxCell id="dot_sda_bus" value="" style="ellipse;fillColor=#00997A;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="756" y="326" width="8" height="8" as="geometry" />
        </mxCell>
        <mxCell id="dot_sda_oled" value="" style="ellipse;fillColor=#00997A;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="756" y="263" width="8" height="8" as="geometry" />
